{
  "name": "qbz-downloader",
  "version": "5.6.3",
  "description": "Desktop-first Qobuz downloader EXE with Hi-Res audio, metadata automation, and lyrics support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "build:full": "npm run sync-version && cd client && npm ci && npm run build && cd .. && npm run build",
    "clean": "rimraf dist coverage",
    "copy-assets": "copyfiles -u 1 \"src/services/dashboard/public/**/*\" dist",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "sync-version": "node scripts/sync-version.js",
    "test": "npm run test:native && npx vitest run",
    "test:native": "npm rebuild better-sqlite3",
    "test:watch": "npx vitest",
    "test:coverage": "npx vitest run --coverage",
    "test:smoke": "node tests/electron-smoke.mjs",
    "bundle-binaries": "node scripts/bundle-binaries.cjs",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "docs": "typedoc --out docs src/index.ts",
    "desktop:rebuild": "node scripts/rebuild-electron-native.cjs",
    "desktop:start": "npm run build:full && npm run desktop:rebuild && electron electron/main.cjs",
    "prepare": "husky"
  },
  "keywords": [
    "qobuz",
    "downloader",
    "hi-res",
    "flac",
    "music",
    "metadata",
    "lyrics",
    "lossless",
    "audio",
    "music-downloader",
    "hifi",
    "desktop-app",
    "electron",
    "windows-exe"
  ],
  "author": "ifauzeee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ifauzeee/QBZ-Downloader.git"
  },
  "bugs": {
    "url": "https://github.com/ifauzeee/QBZ-Downloader/issues"
  },
  "homepage": "https://github.com/ifauzeee/QBZ-Downloader#readme",
  "overrides": {
    "brace-expansion": "5.0.12"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "chalk": "^6.0.1",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "csv-parse": "^7.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "ffmpeg-static": "^5.3.0",
    "lru-cache": "^11.5.3",
    "music-metadata": "^11.16.1",
    "node-id3": "^0.2.9",
    "p-limit": "^7.3.3",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cheerio": "^0.22.35",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "copyfiles": "^2.4.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  }
}
